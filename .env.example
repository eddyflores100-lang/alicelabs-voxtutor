# VoxTutor — by AliceLabs
# Copia a .env y ajusta. Todo es OPCIONAL: sin envs, corre en modo local.

# (Opcional) Nebius Token Factory — IA completa con NVIDIA Nemotron
# Sin esta clave, la app usa el tutor heurístico local (Modo demo básico).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# (Opcional) Memoria persistente vía Vercel Edge Config
# Sin estas variables, la memoria vive solo en memoria del proceso.
EDGE_CONFIG_ID=
EDGE_CONFIG_TOKEN=
EDGE_CONFIG_TEAM_ID=

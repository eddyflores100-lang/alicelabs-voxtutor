# VoxTutor — by AliceLabs
# Copia este archivo a .env y ajusta los valores.

# Base de datos local (SQLite via Prisma, resuelta relativa a prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# (Opcional) Nebius Token Factory — modo producción con NVIDIA Nemotron
# Sin esta clave, VoxTutor corre en modo demo con el proveedor LLM integrado.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

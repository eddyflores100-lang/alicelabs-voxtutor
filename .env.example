# VoxTutor — by AliceLabs
# Copia a .env y ajusta. Todo es OPCIONAL: sin envs, corre en modo local (demo).

# (Opcional) Nebius Token Factory — IA completa con NVIDIA Nemotron
# Sin esta clave, la app usa el tutor heurístico local (Modo demo básico).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Multi-Model Routing (arquitectura dual recomendada por NVIDIA/Nebius)
NEBIUS_MODEL_FAST=nvidia/llama-3.3-nemotron-super-49b-v1
NEBIUS_MODEL_DEEP=nvidia/llama-3.1-nemotron-ultra-253b-v1

# (Opcional) Tavily Search — contexto del mundo real (empresas/ciudades en escenarios)
# Premio "Best Use of Tavily". Créditos gratis en el Nebius Builder Program.
TAVILY_API_KEY=

# (Opcional) Memoria persistente vía Vercel Edge Config
# Sin estas variables, la memoria vive solo en memoria del proceso.
EDGE_CONFIG_ID=
EDGE_CONFIG_TOKEN=
EDGE_CONFIG_TEAM_ID=
